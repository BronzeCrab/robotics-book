---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangToggle from "../components/LangToggle.astro";
import { asLocale, locales, localePath, stripLocale, t } from "../lib/i18n";
import { getBook } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  print?: boolean;
}

const locale = asLocale(Astro.currentLocale);
const book = getBook(locale);
const { title, description, print = false } = Astro.props;
const pageTitle = title ? `${title} · ${book.title}` : book.title;
const path = stripLocale(Astro.url.pathname);
const canonical = Astro.site
  ? new URL(localePath(locale, path), Astro.site).href
  : undefined;
---

<!doctype html>
<html
  lang={locale}
  transition:animate="none"
  data-theme={print ? "light" : undefined}
  data-print={print ? "true" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.site &&
        locales.map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(localePath(code, path), Astro.site).href}
          />
        ))
    }
    {
      Astro.site && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath("ru", path), Astro.site).href}
        />
      )
    }
    {!print && <ClientRouter fallback="swap" />}
    {
      !print && (
        <script is:inline>
          (function () {
            function readTheme() {
              try {
                return (
                  localStorage.getItem("theme") ||
                  (window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light")
                );
              } catch (e) {
                return "light";
              }
            }
            function applyTheme(root) {
              root.dataset.theme = readTheme();
            }
            applyTheme(document.documentElement);
            if (!window.__themeSwapBound) {
              window.__themeSwapBound = true;
              document.addEventListener("astro:before-swap", function (event) {
                applyTheme(event.newDocument.documentElement);
              });
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">{t(locale, "skipToContent")}</a>
    <header class="site-header" transition:persist={`site-header-${locale}`}>
      <a class="site-mark" href={localePath(locale, "/")}>{book.title}</a>
      <nav class="site-nav" aria-label={t(locale, "navAria")}>
        <a href={localePath(locale, "/")}>{t(locale, "toc")}</a>
        <a href={localePath(locale, "/downloads/")}>{t(locale, "downloads")}</a>
      </nav>
      {
        !print && (
          <div class="site-tools">
            <LangToggle />
            <ThemeToggle />
          </div>
        )
      }
    </header>
    <slot />
  </body>
</html>
