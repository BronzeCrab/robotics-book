---
import BookLayout from "../components/BookLayout.astro";
import { getChapters, groupedByPart } from "../lib/chapters";

const chapters = await getChapters();
const parts = groupedByPart(chapters);
const first = chapters[0];
---

<BookLayout
  title="Оглавление"
  description="Статическая книга по робототехнике: кинематика, формулы Typst и Python."
  chapters={chapters}
>
  <p class="chapter-kicker">Черновик</p>
  <h1>Книга по робототехнике</h1>
  <p class="chapter-lede">
    Открытый конспект: геометрия манипуляторов, формулы на Typst и рабочие примеры на Python.
  </p>

  {
    parts.map(({ part, chapters: partChapters }) => (
      <section class="home-part">
        {!(
          partChapters.length === 1 && partChapters[0].data.title === part
        ) && <h2>{part}</h2>}
        <ul class="home-chapters">
          {partChapters.map((chapter) => (
            <li>
              <a href={`/chapters/${chapter.id}/`}>
                <span class="home-chapter-title">{chapter.data.title}</span>
                <span class="home-chapter-summary">{chapter.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    first && (
      <p class="home-start">
        <a class="pager-link" href={`/chapters/${first.id}/`}>
          <span class="pager-dir">Начать читать</span>
          <span class="pager-title">{first.data.title}</span>
        </a>
      </p>
    )
  }
</BookLayout>
