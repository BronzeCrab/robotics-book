---
import Base from "../layouts/Base.astro";
import type { Chapter } from "../lib/chapters";
import { chapterHref, groupedByPart } from "../lib/chapters";
import { asLocale, t } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  chapters: Chapter[];
  currentId?: string;
  prev?: Chapter;
  next?: Chapter;
}

const locale = asLocale(Astro.currentLocale);
const { title, description, chapters, currentId, prev, next } = Astro.props;
const parts = groupedByPart(chapters);
---

<Base title={title} description={description}>
  <div class="book-shell">
    <aside class="toc" transition:persist={`book-toc-${locale}`}>
      <p class="toc-label">{t(locale, "toc")}</p>
      {
        parts.map(({ part, chapters: partChapters }) => (
          <section class="toc-part">
            {!(
              partChapters.length === 1 && partChapters[0].data.title === part
            ) && <h2>{part}</h2>}
            <ol>
              {partChapters.map((chapter) => (
                <li>
                  <a
                    href={chapterHref(locale, chapter)}
                    aria-current={chapter.id === currentId ? "page" : undefined}
                  >
                    {chapter.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </aside>

    <div class="book-main">
      <article id="content" class="chapter-body">
        <slot />
      </article>

      {
        (prev || next) && (
          <nav class="pager" aria-label={t(locale, "pagerAria")}>
            {prev ? (
              <a class="pager-link" href={chapterHref(locale, prev)}>
                <span class="pager-dir">{t(locale, "pagerPrev")}</span>
                <span class="pager-title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="pager-link pager-next" href={chapterHref(locale, next)}>
                <span class="pager-dir">{t(locale, "pagerNext")}</span>
                <span class="pager-title">{next.data.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </div>
</Base>
