---
import { asLocale, t } from "../lib/i18n";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const locale = asLocale(Astro.currentLocale);
---

<figure class="book-scene">
  <div class="book-scene-frame">
    <slot />
  </div>
  <p class="book-scene-fallback">
    {t(locale, "sceneFallback")}
  </p>
  <figcaption>{caption}</figcaption>
</figure>
