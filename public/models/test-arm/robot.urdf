<?xml version="1.0"?>
<robot name="test-arm">
  <material name="base">
    <color rgba="0.16 0.16 0.19 1"/>
  </material>
  <material name="blue">
    <color rgba="0.15 0.39 0.92 1"/>
  </material>
  <material name="teal">
    <color rgba="0.06 0.46 0.43 1"/>
  </material>
  <material name="steel">
    <color rgba="0.55 0.58 0.63 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.14" length="0.06"/>
      </geometry>
      <material name="base"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.4"/>
      </geometry>
      <material name="teal"/>
    </visual>
  </link>

  <link name="gripper">
    <visual>
      <origin xyz="0.04 0.035 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.08"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="0.04 -0.035 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.02 0.08"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>

  <joint name="base_to_link_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="20" velocity="2"/>
  </joint>

  <joint name="link_1_to_link_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.2" upper="2.2" effort="15" velocity="2"/>
  </joint>

  <joint name="link_2_to_gripper" type="fixed">
    <parent link="link_2"/>
    <child link="gripper"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
  </joint>
</robot>
